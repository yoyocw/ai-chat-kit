<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.yoyocw</groupId>
    <artifactId>ai-chat-kit-dependencies</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>AI Chat Kit Dependency Management</name>
    <description>AI Chat Kit Java 8 / Spring Boot 2.7 组件依赖版本管理</description>
    <url>https://github.com/yoyocw/ai-chat-kit</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <scm>
        <connection>scm:git:https://github.com/yoyocw/ai-chat-kit.git</connection>
        <developerConnection>scm:git:https://github.com/yoyocw/ai-chat-kit.git</developerConnection>
        <url>https://github.com/yoyocw/ai-chat-kit</url>
        <tag>HEAD</tag>
    </scm>
    <properties>
        <revision>2.0.0-SNAPSHOT</revision>
        <flatten-maven-plugin.version>1.7.2</flatten-maven-plugin.version>
        <spring.framework.version>5.3.39</spring.framework.version>
        <spring.security.version>5.8.16</spring.security.version>
        <spring.boot.version>2.7.18</spring.boot.version>
        <mockito-inline.version>4.11.0</mockito-inline.version>
        <lombok.version>1.18.42</lombok.version>
        <mybatis-plus.version>3.5.15</mybatis-plus.version>
        <mybatis-spring.version>2.1.2</mybatis-spring.version>
        <okhttp.version>4.12.0</okhttp.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.yoyocw</groupId>
                <artifactId>ai-chat-kit-model-bailian</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mybatis</groupId>
                <artifactId>mybatis-spring</artifactId>
                <version>${mybatis-spring.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yoyocw</groupId>
                <artifactId>ai-chat-kit-adapter-hosted-proxy</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yoyocw</groupId>
                <artifactId>ai-chat-kit-adapter-web</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yoyocw</groupId>
                <artifactId>ai-chat-kit-host-platform</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yoyocw</groupId>
                <artifactId>ai-chat-kit-host-ruoyi</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yoyocw</groupId>
                <artifactId>ai-chat-kit-adapter-mcp-jwt-v1</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yoyocw</groupId>
                <artifactId>ai-chat-kit-mcp-jwt</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yoyocw</groupId>
                <artifactId>ai-chat-kit-contract</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yoyocw</groupId>
                <artifactId>ai-chat-kit-engine</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yoyocw</groupId>
                <artifactId>ai-chat-kit-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yoyocw</groupId>
                <artifactId>ai-chat-kit-adapter-mybatis-plus</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-framework-bom</artifactId>
                <version>${spring.framework.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.security</groupId>
                <artifactId>spring-security-bom</artifactId>
                <version>${spring.security.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-configuration-processor</artifactId>
                <version>${spring.boot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-inline</artifactId>
                <version>${mockito-inline.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-test</artifactId>
                <version>${spring.boot.version}</version>
                <exclusions>
                    <exclusion>
                        <artifactId>asm</artifactId>
                        <groupId>org.ow2.asm</groupId>
                    </exclusion>
                    <exclusion>
                        <groupId>org.mockito</groupId>
                        <artifactId>mockito-core</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <flattenMode>bom</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                    </execution>
                    <execution>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>