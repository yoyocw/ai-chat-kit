<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>example.ai</groupId>
    <artifactId>ai-component-consumer</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>AI Chat Kit Independent Component Consumer</name>
    <description>源码树外验证 AI Chat Kit 候选 JAR、注解及配置接入闭包</description>

    <properties>
        <java.version>1.8</java.version>
        <ai.version>1.2.0-SNAPSHOT</ai.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.yoyocw</groupId>
            <artifactId>ai-chat-kit-starter</artifactId>
            <version>${ai.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.yoyocw</groupId>
            <artifactId>ai-chat-kit-adapter-web</artifactId>
            <version>${ai.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.yoyocw</groupId>
            <artifactId>ai-chat-kit-adapter-jdbc</artifactId>
            <version>${ai.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.yoyocw</groupId>
            <artifactId>ai-chat-kit-adapter-mcp-jwt-v1</artifactId>
            <version>${ai.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
